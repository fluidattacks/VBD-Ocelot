{
  "Routes": [
    {
      "UpstreamPathTemplate": "/limited/{everything}",
      "UpstreamHttpMethod": [ "Get" ],
      "DownstreamPathTemplate": "/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "downstream", "Port": 80 } ],
      "RateLimitOptions": {
        "ClientWhitelist": [],
        "EnableRateLimiting": true,
        "Period": "1m",
        "PeriodTimespan": 60,
        "Limit": 3
      }
    },
    {
      "UpstreamPathTemplate": "/restricted/{everything}",
      "UpstreamHttpMethod": [ "Get" ],
      "DownstreamPathTemplate": "/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [ { "Host": "downstream", "Port": 80 } ],
      "SecurityOptions": {
        "IPAllowedList": [ "203.0.113.7" ],
        "IPBlockedList": []
      }
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5555"
  }
}
